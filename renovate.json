{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prConcurrentLimit10"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "split out patches for Android Gradle plugin",
      "matchPackageNames": [
        "com.android.application",
        "com.android.library"
      ],
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "group Swift Firebase dependencies",
      "groupName": "firebase",
      "matchManagers": [
        "xcodegen"
      ],
      "matchPackageNames": [
        "firebase/*",
        "google/*",
        "googleads/*"
      ]
    },
    {
      "description": "group Swift Mapbox dependencies",
      "groupName": "mapbox",
      "matchManagers": [
        "xcodegen"
      ],
      "matchPackageNames": [
        "mapbox/*"
      ]
    },
    {
      "description": "ignore sentry-cocoa (lining it up with sentry-kmp would be really hard)",
      "enabled": false,
      "matchPackageNames": [
        "getsentry/sentry-cocoa"
      ]
    },
    {
      "description": "simplify Swift dependency identification",
      "matchManagers": [
        "xcodegen"
      ],
      "overrideDepName": "{{ packageName }}"
    },
    {
      "description": "ignore buildSrc (keeping in sync with Gradle would be hard)",
      "enabled": false,
      "matchFileNames": [
        "buildSrc/build.gradle.kts"
      ]
    },
    {
      "description": "look up Mapbox Android versions in GitHub",
      "extractVersion": "^v(?<version>.*)$",
      "matchPackageNames": [
        "com.mapbox.*",
        "!com.mapbox.*:*-turf"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "mapbox/mapbox-maps-android",
      "registryUrls": [
        "https://github.com"
      ]
    }
  ],
  "rebaseWhen": "conflicted"
}
